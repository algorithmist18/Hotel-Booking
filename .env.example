# Copy this file to `.env` and fill in your real key.
#   cp .env.example .env
# `.env` is gitignored — it is never committed. The app auto-loads it at startup
# (via python-dotenv), so the AI Advisor agents read the key from the
# environment with no UI needed.
#
# Get a key at https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-gemini-api-key-here
