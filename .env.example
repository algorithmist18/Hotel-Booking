# Copy this file to `.env` and fill in your real key(s).
#   cp .env.example .env
# `.env` is gitignored — it is never committed. The app auto-loads it at startup
# (via python-dotenv), so the AI Advisor agents read the key from the
# environment with no UI needed. Set the key for whichever provider you pick in
# the AI Advisor tab (OpenAI is the default).

# OpenAI (default) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Gemini (optional) — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
